# Copy to .env (gitignored) and adjust. Every value below is read at startup by
# app.config.load_settings(); the process refuses to boot if one is missing.
#
# Two namespaces, deliberately separate (§34):
#   GYM_TRACK_*         non-secret configuration
#   GYM_TRACK_SECRET_*  secret values, resolved through the SecretsProvider port
#
# The values here match docker/compose.yaml, so `make up` and a local run agree.

GYM_TRACK_ENVIRONMENT=local

# --- Postgres --------------------------------------------------------------
GYM_TRACK_POSTGRES__HOST=localhost
GYM_TRACK_POSTGRES__PORT=5432
GYM_TRACK_POSTGRES__DATABASE=gym_track

# The DDL identity used by `make migrate`. Not a service role: migration 0002
# creates and grants those.
GYM_TRACK_POSTGRES__ADMIN__USER=gym_track
GYM_TRACK_SECRET_POSTGRES_ADMIN_PASSWORD=local-dev-only

# One role per process that opens a connection (Q145). The grants that make
# these roles least-privilege arrive with migration 0002 in WS-3.
GYM_TRACK_POSTGRES__ROLES__API__USER=gym_api
GYM_TRACK_POSTGRES__ROLES__MESSAGE-AGGREGATOR__USER=gym_message_aggregator
GYM_TRACK_POSTGRES__ROLES__WORKFLOW-WORKER__USER=gym_workflow_worker
GYM_TRACK_POSTGRES__ROLES__OUTBOX-PUBLISHER__USER=gym_outbox_publisher
GYM_TRACK_POSTGRES__ROLES__DISPATCHER__USER=gym_dispatcher

GYM_TRACK_SECRET_POSTGRES_API_PASSWORD=local-dev-only
GYM_TRACK_SECRET_POSTGRES_MESSAGE_AGGREGATOR_PASSWORD=local-dev-only
GYM_TRACK_SECRET_POSTGRES_WORKFLOW_WORKER_PASSWORD=local-dev-only
GYM_TRACK_SECRET_POSTGRES_OUTBOX_PUBLISHER_PASSWORD=local-dev-only
GYM_TRACK_SECRET_POSTGRES_DISPATCHER_PASSWORD=local-dev-only

# --- RabbitMQ --------------------------------------------------------------
GYM_TRACK_RABBITMQ__HOST=localhost
GYM_TRACK_RABBITMQ__PORT=5672
GYM_TRACK_RABBITMQ__VIRTUAL_HOST=/
GYM_TRACK_RABBITMQ__USER=gym_track
GYM_TRACK_SECRET_RABBITMQ_PASSWORD=local-dev-only

# --- Redis -----------------------------------------------------------------
GYM_TRACK_REDIS__HOST=localhost
GYM_TRACK_REDIS__PORT=6379
GYM_TRACK_REDIS__DATABASE=0
# GYM_TRACK_SECRET_REDIS_PASSWORD=   # unset locally; compose runs Redis open

# --- Workflow --------------------------------------------------------------
# 32 partitions is frozen by DEC-006: changing it reorders every user's stream.
GYM_TRACK_WORKFLOW__PARTITIONS=32
GYM_TRACK_WORKFLOW__DEBOUNCE_WINDOW=PT3S
GYM_TRACK_WORKFLOW__MAX_BATCH_WINDOW=PT10S
GYM_TRACK_WORKFLOW__CONVERSATION_TIMEOUT=PT12H
GYM_TRACK_WORKFLOW__TRAINING_SESSION_TIMEOUT=PT3H
GYM_TRACK_WORKFLOW__CORRECTION_GRACE_PERIOD=PT30M

# --- Observability ---------------------------------------------------------
GYM_TRACK_OBSERVABILITY__SERVICE_NAME=gym-track
GYM_TRACK_OBSERVABILITY__LOG_LEVEL=INFO

# --- Security --------------------------------------------------------------
# Never real values in this file: it is committed.
GYM_TRACK_SECRET_SECURITY_WHATSAPP_APP_SECRET=local-dev-only
GYM_TRACK_SECRET_SECURITY_BSUID_ENCRYPTION_KEY=local-dev-only-32-bytes-minimum!!
GYM_TRACK_SECRET_SECURITY_BSUID_LOOKUP_HMAC_KEY=local-dev-only-32-bytes-minimum!
